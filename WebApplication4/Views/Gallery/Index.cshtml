@model List<WebApplication4.Models.Image>
@{
    ViewData["Title"] = "Gallery";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Image Gallery</title>
    <style>

        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(500px, 1fr)); /* Устанавливает количество колонок */
            gap: 10px; /* Отступ между изображениями */
            background-color: #74917b;
            border-radius: 15px;
            padding: 10px;
        }

            .gallery img:hover {
                transform: scale(1.05); /* Увеличиваем изображение при наведении */
                border-radius: 10px;
                transition: transform 0.2s;
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
            }

            .gallery img{
                border-radius: 5px;
            }

        .container-home3 {
            border: 5px solid #55605a;
            border-radius: 15px;
            padding: 70px;
        }
    </style>
</head>
<body>
    <main class="container-home3">
        <h1 style="text-align: center; position: relative; bottom: 40px; font-weight: bold">@ViewData["Title"]</h1>
        <div class="gallery">
            <ul class="list-unstyled row">
                @foreach (var image in Model)
                {
                    <li class="col-md-4 mb-3">
                        <img src="@Url.Action("DisplayImage", "Gallery", new { id = image.Id })" alt="@image.Title" class="img-fluid" style="max-width: 100%; height: 150px;" loading="lazy" />
                    </li>
                }
            </ul>
        </div>
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>