@model List<WebApplication4.Models.Image>

<h1>Image Gallery</h1>
    <div class="gallery">
        <ul>
            @foreach (var image in Model)
            {
                <li>
                    <img src="@Url.Action("DisplayImage", "Gallery", new { id = image.Id })" alt="@image.Title" style="max-width: 200px; max-height: 200px;" />
                </li>
            }
        </ul>
    </div>
<link rel="stylesheet" href="~/css/style1.css" />