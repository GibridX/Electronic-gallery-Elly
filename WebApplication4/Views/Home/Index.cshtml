@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>@ViewData["Title"]</title>
    <style>
        .container-home1{
            border: 5px solid #55605a;
            border-radius: 15px;
            padding: 70px;
        }

    </style>
</head>
<body>
    <main class="container-home1">
        <h1 class="h1-home" style="font-size: 80px; letter-spacing: 0.1em; transform: scale(1.2);">elly</h1>
        <p class="description" style="font-weight: 600; line-height: 1.5; letter-spacing: 0.1em;">Удобная онлайн-галерея изображений, созданная с помощью ASP.NET, предлагающая интуитивно понятный просмотр, надежные возможности поиска и безопасную аутентификацию пользователей.</p>
    </main>
</body>
</html>